<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/mouse_buttons_top"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        layout="@layout/mouse_buttons"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <io.appground.blek.utils.PointerPathView
            android:layout_gravity="center"
            android:id="@+id/touch"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
            app:srcCompat="@drawable/ic_outline_mouse_36"
            app:tint="?attr/imageContentColor"
            style="?attr/touchCardStyle"/>
        <ImageView
            android:id="@+id/left_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_baseline_keyboard_arrow_up_24"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/left_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/touch"
            app:tint="?attr/imageContentColor"/>
        <View
            android:id="@+id/left_bar"
            android:background="@drawable/scrollbar"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/left_down"
            app:layout_constraintEnd_toEndOf="@+id/left_up"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="@+id/left_up"
            app:layout_constraintTop_toBottomOf="@+id/left_up"/>
        <ImageView
            android:id="@+id/left_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:layout_constraintBottom_toBottomOf="@+id/touch"
            app:layout_constraintEnd_toEndOf="@+id/left_bar"
            app:layout_constraintStart_toStartOf="@+id/left_bar"
            app:layout_constraintTop_toBottomOf="@+id/left_bar"
            app:tint="?attr/imageContentColor"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/scrollbar_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="left_up,left_bar,left_down"/>
        <ImageView
            android:id="@+id/right_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_baseline_keyboard_arrow_up_24"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/right_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/touch"
            app:tint="?attr/imageContentColor"/>
        <View
            android:id="@+id/right_bar"
            android:background="@drawable/scrollbar"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/right_down"
            app:layout_constraintEnd_toEndOf="@+id/right_up"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="@+id/right_up"
            app:layout_constraintTop_toBottomOf="@+id/right_up"/>
        <ImageView
            android:id="@+id/right_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            app:layout_constraintBottom_toBottomOf="@+id/touch"
            app:layout_constraintEnd_toEndOf="@+id/right_bar"
            app:layout_constraintStart_toStartOf="@+id/right_bar"
            app:layout_constraintTop_toBottomOf="@+id/right_bar"
            app:tint="?attr/imageContentColor"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/scrollbar_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="right_up,right_bar,right_down"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/mouse_buttons_bottom"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        layout="@layout/mouse_buttons"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="center"
        android:id="@+id/airmouse_touch"
        android:background="?attr/colorSurface"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:scaleType="center"
        android:backgroundTint="@color/toggle_button_selector"
        app:shapeAppearance="?attr/shapeAppearanceMediumComponent"
        app:srcCompat="@drawable/ic_gyro"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp"
        app:tint="?attr/colorPrimary"/>
    <Button
        android:id="@+id/disable_capture_button"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disable_direct_mouse_input"/>
</LinearLayout>
