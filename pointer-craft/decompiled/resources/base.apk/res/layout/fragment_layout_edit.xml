<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:background="@drawable/icon_round_background"
                    android:padding="8dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:srcCompat="@drawable/ic_info_24px"
                    app:tint="?attr/colorOnPrimary"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:paddingLeft="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcuts_edit_help"
                    android:lineHeight="20dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:paddingBottom="72dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.compose.ui.platform.ComposeView
        android:layout_gravity="bottom"
        android:id="@+id/component_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/edit_bar"
        android:background="?attr/colorSurface"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="8dp"
        app:behavior_draggable="false"
        app:behavior_hideable="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/style_group"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:layout_gravity="center"
                    android:id="@+id/contained_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    app:icon="@drawable/ic_baseline_text_fields_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    style="@style/Widget.App.Button.IconOnly"/>
                <com.google.android.material.button.MaterialButton
                    android:layout_gravity="center"
                    android:id="@+id/outline_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    app:icon="@drawable/ic_baseline_text_fields_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    style="@style/Widget.App.Button.IconOnly"/>
                <com.google.android.material.button.MaterialButton
                    android:layout_gravity="center"
                    android:id="@+id/text_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    app:icon="@drawable/ic_baseline_text_fields_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    style="@style/Widget.App.Button.IconOnly"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="center"
                android:id="@+id/color_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:icon="@drawable/ic_baseline_color_lens_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                style="@style/Widget.App.Button.UnelevatedButton.IconOnly"/>
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="center"
                android:id="@+id/height_smaller_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:icon="@drawable/ic_baseline_unfold_less_24"
                app:iconGravity="textStart"
                style="@style/Widget.App.Button.UnelevatedButton.IconOnly"/>
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="center"
                android:id="@+id/height_bigger_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                app:icon="@drawable/ic_baseline_unfold_more_24"
                app:iconGravity="textStart"
                style="@style/Widget.App.Button.UnelevatedButton.IconOnly"/>
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/group"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:layout_gravity="center"
                    android:id="@+id/wrap_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    app:icon="@drawable/ic_baseline_wrap_text_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grow_group"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:layout_gravity="center"
                    android:id="@+id/grow_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    app:icon="@drawable/ic_open_in_full_white_24dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    style="@style/Widget.App.Button.OutlinedButton.IconOnly"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
